{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "ignoreDeprecations": "6.0",
    "paths": { "@/*": ["./auction-tracker-clean/frontend/src/*"] }
  },
  "include": [
    "auction-tracker-clean/frontend/src/**/*.ts",
    "auction-tracker-clean/frontend/src/**/*.tsx",
    "auction-tracker-clean/backend/src/**/*.js"
  ],
  "exclude": ["node_modules", "**/.next"]
}
